# Copy this file to .env and fill in your key to turn on AI-generated MCQs.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: model used for question generation (default claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5
# Optional: port (default 3000)
# PORT=3000
# Online database (Turso). Leave empty to use the local studyhub.db file.
# TURSO_DATABASE_URL=libsql://your-db-name-your-user.turso.io
# TURSO_AUTH_TOKEN=
